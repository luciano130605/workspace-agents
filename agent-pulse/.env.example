# Para recibir push en el dispositivo móvil, configure MONITOR_TOKEN al exponer Pulse fuera de loopback.
# Genere una clave al azar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MONITOR_TOKEN=colocar-una-clave-aleatoria-de-al-menos-32-caracteres
# HOST=127.0.0.1
# PORT=4318
# PROJECTS_ROOT=C:\\ruta\\al\\workspace
# CODEX_HOME=C:\\Users\\usuario\\.codex
# CODEX_BIN=C:\\Users\\usuario\\ruta\\codex.exe
# VAPID_SUBJECT=mailto:tu-correo@example.com
